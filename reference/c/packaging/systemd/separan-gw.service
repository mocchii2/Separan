[Unit]
Description=Separan Gateway Worker
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/sysconfig/separan-gw
ExecStart=/usr/bin/separan-gw --config ${SEPARAN_GW_CONFIG}
RuntimeDirectory=separan-gw
User=separan
Group=separan
Restart=on-failure
RestartSec=1s
TimeoutStopSec=10s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
