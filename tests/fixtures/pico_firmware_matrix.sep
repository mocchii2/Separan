########################################
# Pico firmware backend conformance
########################################

SEP:blink_once
gpio_set_mode(pin.LED_BUILTIN, "output")
gpio_write(pin.LED_BUILTIN, true)
delay_milliseconds(1)
gpio_write(pin.LED_BUILTIN, false)
END_SEP:blink_once

SEP:read_button
gpio_set_mode(pin.D2, "input_pull_up")
return !gpio_read(pin.D2)
END_SEP:read_button

SEP:exercise_pwm
pwm_write(pin.D3, 0.5)
END_SEP:exercise_pwm

SEP:exercise_adc
value = analog_read(pin.A0)
print value
END_SEP:exercise_adc

SEP:exercise_i2c
bus = i2c_open(0)
print i2c_probe(bus, 42)
END_SEP:exercise_i2c

SEP:exercise_uart
serial = uart_open(0)
uart_write(serial, "Separan\n")
line = uart_read_line(serial)
print line
END_SEP:exercise_uart

SEP:main
blink_once()
print read_button()
exercise_pwm()
exercise_adc()
exercise_i2c()
exercise_uart()
END_SEP:main
