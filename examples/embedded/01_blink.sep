########################################
# Portable Blink
########################################

function:main

@embedded
@gpio
@sample

gpio_set_mode(pin.LED_BUILTIN, "output")

while true :blink_loop

gpio_write(pin.LED_BUILTIN, true)
delay_milliseconds(500)

gpio_write(pin.LED_BUILTIN, false)
delay_milliseconds(500)

endwhile:blink_loop

end_function:main
