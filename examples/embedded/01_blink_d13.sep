########################################
# Board-specific D13 Blink
########################################

function:main

@embedded
@gpio
@sample

led = pin.D13
gpio_set_mode(led, "output")

while true :blink_loop
gpio_write(led, true)
delay_milliseconds(500)
gpio_write(led, false)
delay_milliseconds(500)
endwhile:blink_loop

end_function:main
