http_route GET "/bench" :cpu_bench
checksum = 0
for seed in range(1, 10001) :seed_loop
value = seed
for round in range(1, 51) :round_loop
value = (value * 1664525 + 1013904223) % 2147483647
endfor:round_loop
checksum = checksum + value
endfor:seed_loop
return_http(status = 200, body = "ok")
end_http_route:cpu_bench
