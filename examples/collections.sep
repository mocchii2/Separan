SEP:double(value)
return value * 2
END_SEP:double

SEP:is_large(value)
return value >= 10
END_SEP:is_large

SEP:add(total, value)
return total + value
END_SEP:add

SEP:main

values = [2, 5, 10, 20]

print map(values, double)
print filter(values, is_large)
print reduce(values, add, 0)
print flatten([[1, 2], [3, 4]])
print sum(values)
print average(values)
print count(values, 10)

print reverse("Separan")
print char_at("日本語", 1)
print find_all("banana", "an")

print sqrt(16)
print sin(0)
print log10(1000)

END_SEP:main
