import "notify.sep" as notification

function:check(store, job, minute)
job_history = append(store.job_history, job)
updated_store = object_set(store, "job_history", job_history)
deadline = job.expected_finish_minute + job.grace_minutes

if job.state == "COMPLETED" :job_completed
return notification.no_notification(updated_store)
endif:job_completed

alert_type = "job_overdue"
message = format("Job {} did not complete by minute {}.", job.name, string(deadline))

if job.state == "FAILED" :job_failed
alert_type = "job_failed"
message = format("Job {} reported a failure marker.", job.name)
endif:job_failed

if job.state != "FAILED" && minute <= deadline :job_still_running
return notification.no_notification(updated_store)
endif:job_still_running

candidate = notification.new_candidate()
candidate = object_set(candidate, "resource_id", job.resource_id)
candidate = object_set(candidate, "resource_type", "ec2")
candidate = object_set(candidate, "resource_name", job.resource_name)
candidate = object_set(candidate, "alert_type", alert_type)
candidate = object_set(candidate, "severity", "CRITICAL")
candidate = object_set(candidate, "source", job.log_name)
candidate = object_set(candidate, "rule_id", job.name)
candidate = object_set(candidate, "message", message)
candidate = object_set(candidate, "dedup_key", format("{}|{}|{}", job.resource_id, alert_type, job.name))

return notification.evaluate(updated_store, candidate, minute)
end_function:check
