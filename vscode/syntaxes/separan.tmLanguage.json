{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Separan", "scopeName": "source.separan",
  "patterns": [
    { "name": "comment.block.separan", "begin": "^\\s*::([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s*$", "end": "^\\s*::\\1\\s*$" },
    { "name": "comment.line.colon.separan", "match": "^\\s*:(?!:).*$" },
    { "name": "string.quoted.double.separan", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.separan", "match": "\\\\[nrt\"\\\\]" }] },
    { "name": "constant.numeric.separan", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" },
    { "name": "constant.language.separan", "match": "\\b(?:true|false|null)\\b" },
    { "name": "keyword.operator.separan", "match": "\\*\\*=|//=|\\+=|-=|\\*=|/=|%=|\\?\\?|\\*\\*|//|==|!=|>=|<=|&&|\\|\\||[+\\-*/%><!=]|\\b(?:in|not)\\b" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:cookie_jar|cookie_get|cookie_set|cookie_remove|cookie_clear|cookie_all|cookie_save_secure|cookie_load_secure)(?=\\s*\\()" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:len|length|is_empty|type|abs|range|number|string|boolean|input|trim|upper|lower|contains|starts_with|ends_with|split|join|replace|substring|index_of|last_index_of|repeat|pad_left|pad_right|bytes_from_string|string_from_bytes|bytes_get|slice_bytes|bytes_concat|hex_encode|hex_decode|bytes_from_hex|base64_encode|base64_decode|secret_get|basic_auth|bearer_auth|api_key_auth|oauth_client_credentials|hmac_sha256|jwt_sign|jwt_verify|password_hash|password_verify|datetime|local_datetime|timezone|duration|datetime_from_local|datetime_in_timezone|datetime_now|unix_milliseconds_from_datetime|unix_seconds_from_datetime|datetime_from_unix_milliseconds|datetime_from_unix_seconds|datetime_offset|datetime_timezone|datetime_year|datetime_month|datetime_day|datetime_hour|datetime_minute|datetime_second|datetime_millisecond|duration_milliseconds|random_seed|random_number|random_int|random_float|random_bool|random_pick|random_shuffle|random_sample|secure_random_bytes|secure_random_int|secure_random_string|list_append|list_remove|size|first|last|slice|reverse|sort|sort_descending|sort_ignore_case|sort_ignore_case_descending|sort_natural|sort_natural_descending|sort_natural_ignore_case|sort_natural_ignore_case_descending|sort_by|sort_by_descending|object_get|object_has|object_set|object_remove|object_keys|object_values|read_text|write_text|append_text|read_bytes|write_bytes|json_decode|json_encode|exec|exec_checked|shell_exec|command_exists|http_get|http_request|http_profile|http_profile_headers|runtime_error|type_error|value_error|index_error|io_error|parse_error|import_error|regex_error|glob_error|argument_error|permission_error|auth_error|secret_error|oauth_error|regex_match|regex_search|regex_find|regex_find_all|regex_replace|regex_split|regex_text|regex_start|regex_end|regex_group|glob|env_get|env_exists|env_set|env_remove|command_args|arg_exists|arg_value|script_path)(?=\\s*\\()" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:request_method|request_path|request_header|request_param|request_query|request_body|request_cookie|return_http|redirect_http|http_set_cookie|http_host|http_static)(?=\\s*\\()" },
    { "name": "keyword.control.separan", "match": "\\b(?:http_route|end_http_route)\\b" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:compare|compare_ignore_case|substring_before|substring_after|count_occurrences|format|type_of|is_null|append|prepend|remove|remove_at|unique)(?=\\s*\\()" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:ceil|floor|round|min|max|sqrt|pow)(?=\\s*\\()" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:datetime_parse|datetime_valid|datetime_format|datetime_weekday|unix_time|datetime_from_unix)(?=\\s*\\()" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:file_exists|file_size|copy_file|move_file|delete_file|read_lines|directory_exists|create_directory|delete_directory|list_directory|file_name|file_extension|parent_directory|absolute_path)(?=\\s*\\()" },
    { "name": "support.function.builtin.separan", "match": "\\b(?:db_connect|db_close|db_query|db_query_one|db_scalar|db_execute|db_begin|db_commit|db_rollback|db_tables|db_columns|db_indexes|db_primary_key|db_server_info|db_version)(?=\\s*\\()" },
    { "name": "keyword.control.separan", "match": "\\b(?:transaction|end_transaction)\\b" },
    { "name": "variable.language.system.separan", "match": "\\bsystem\\b" },
    { "name": "support.variable.property.system.separan", "match": "(?<=\\bsystem\\.)(?:version|engine|script_path|script_name|script_dir|working_dir|args|arg_count|os|arch|hostname|pid|runtime|cpu_count)\\b" },
    { "name": "entity.name.function.separan", "match": "(?<=\\bfunction:)[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "entity.name.label.separan", "match": ":[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*" },
    { "name": "storage.modifier.separan", "match": "\\bconst\\b" },
    { "name": "keyword.control.separan", "match": "\\b(?:function|end_function|error|end_error|object|end_object|list|end_list|import|as|try|catch|finally|endtry|throw|if|elseif|else|endif|while|endwhile|for|endfor|print|print_error|return)\\b" }
  ]
}
